                        "label",
                        "children"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "tabs"
                        },
                        "tabs": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "label": {
                                "$ref": "#/definitions/SurfaceDefinition/properties/name"
                              },
                              "children": {
                                "type": "array",
                                "items": {
                                  "$ref": "#/definitions/SurfaceDefinition/properties/screens/items/properties/children/items"
                                }
                              }
                            },
                            "required": [
                              "label",
                              "children"
                            ],
                            "additionalProperties": false
                          },
                          "minItems": 1
                        },
                        "width": {
                          "$ref": "#/definitions/SurfaceDefinition/properties/screens/items/properties/children/items/anyOf/0/properties/width"
                        }
                      },
                      "required": [
                        "kind",
                        "tabs"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": [
              "id",
              "label",
              "children"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "format",
        "version",
        "name",
        "parameters",
        "screens"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
