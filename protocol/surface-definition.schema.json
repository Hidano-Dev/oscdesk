                        }
                      },
                      "required": [
                        "kind",
                        "children"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "group"
                        },
                        "label": {
