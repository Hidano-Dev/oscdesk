{
  "$ref": "#/definitions/SurfaceDefinition",
  "definitions": {
    "SurfaceDefinition": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "oscdesk-surface"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}(?![\\s\\S])"
                  },
                  "address": {
                    "type": "string",
                    "pattern": "^(?!\\/(?:sys|oscdesk)(?:\\/|(?![\\s\\S])))(?:\\/[^\\s/?\\[\\]{},*]+)+(?![\\s\\S])"
                  },
                  "label": {
                    "$ref": "#/definitions/SurfaceDefinition/properties/name"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "state",
                      "trigger"
                    ]
                  },
                  "standalone": {
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string",
                    "const": "i"
                  },
                  "range": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "step": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "default": {
                    "type": "number"
                  },
                  "value": {
                    "type": "number"
                  }
                },
                "required": [
                  "id",
                  "address",
                  "label",
                  "kind",
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/SurfaceDefinition/properties/parameters/items/anyOf/0/properties/id"
                  },
                  "address": {
                    "$ref": "#/definitions/SurfaceDefinition/properties/parameters/items/anyOf/0/properties/address"
                  },
                  "label": {
                    "$ref": "#/definitions/SurfaceDefinition/properties/name"
                  },
                  "kind": {
                    "$ref": "#/definitions/SurfaceDefinition/properties/parameters/items/anyOf/0/properties/kind"
                  },
                  "standalone": {
                    "$ref": "#/definitions/SurfaceDefinition/properties/parameters/items/anyOf/0/properties/standalone"
                  },
                  "type": {
                    "type": "string",
                    "const": "f"
                  },
                  "range": {
                    "$ref": "#/definitions/SurfaceDefinition/properties/parameters/items/anyOf/0/properties/range"
                  },
                  "step": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "default": {
                    "type": "number"
                  },
                  "value": {
                    "type": "number"
                  }
                },
                "required": [
                  "id",
                  "address",
                  "label",
                  "kind",
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/SurfaceDefinition/properties/parameters/items/anyOf/0/properties/id"
                  },
                  "address": {
                    "$ref": "#/definitions/SurfaceDefinition/properties/parameters/items/anyOf/0/properties/address"
                  },
                  "label": {
                    "$ref": "#/definitions/SurfaceDefinition/properties/name"
                  },
                  "kind": {
                    "$ref": "#/definitions/SurfaceDefinition/properties/parameters/items/anyOf/0/properties/kind"
                  },
                  "standalone": {
                    "$ref": "#/definitions/SurfaceDefinition/properties/parameters/items/anyOf/0/properties/standalone"
                  },
                  "type": {
                    "type": "string",
                    "const": "s"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "default": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "address",
                  "label",
                  "kind",
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/SurfaceDefinition/properties/parameters/items/anyOf/0/properties/id"
                  },
                  "address": {
                    "$ref": "#/definitions/SurfaceDefinition/properties/parameters/items/anyOf/0/properties/address"
                  },
                  "label": {
                    "$ref": "#/definitions/SurfaceDefinition/properties/name"
                  },
                  "kind": {
                    "$ref": "#/definitions/SurfaceDefinition/properties/parameters/items/anyOf/0/properties/kind"
                  },
                  "standalone": {
                    "$ref": "#/definitions/SurfaceDefinition/properties/parameters/items/anyOf/0/properties/standalone"
                  },
                  "type": {
                    "type": "string",
                    "const": "bool"
                  },
                  "default": {
                    "type": "boolean"
