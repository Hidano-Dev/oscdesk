{
  "description": "OSCQuery のノードからパッドの部品を決める規則(DESIGN.md D-167。HID-484 の §5)の見本。規則の正は packages/shared/src/pad-from-node.ts だけで、TS の pad-from-node.test.ts が読む。node は OSCQuery のノードの属性を小文字にした最小の形(address = FULL_PATH)。expected.widget は置き場所(id・row・column)を除いた部品で、ok:false は reason を持つ",
  "cases": [
    { "name": "no-type-is-button", "node": { "address": "/fx/fire", "access": 0 }, "expected": { "ok": true, "kinds": ["button"], "widget": { "kind": "button", "label": "fire", "address": "/fx/fire", "args": [] } } },
    { "name": "nil-is-button", "node": { "address": "/fx/fire", "type": "N", "description": "Fire" }, "expected": { "ok": true, "kinds": ["button"], "widget": { "kind": "button", "label": "Fire", "address": "/fx/fire", "args": [] } } },
    { "name": "impulse-is-button", "node": { "address": "/fx/flash", "type": "I", "access": 2 }, "expected": { "ok": true, "kinds": ["button"], "widget": { "kind": "button", "label": "flash", "address": "/fx/flash", "args": [] } } },
    { "name": "true-is-toggle", "node": { "address": "/light", "type": "T", "access": 3 }, "expected": { "ok": true, "kinds": ["toggle", "button"], "widget": { "kind": "toggle", "type": "T", "label": "light", "address": "/light", "resend": true } } },
    { "name": "false-is-toggle", "node": { "address": "/light", "type": "F" }, "expected": { "ok": true, "kinds": ["toggle", "button"], "widget": { "kind": "toggle", "type": "T", "label": "light", "address": "/light", "resend": true } } },
    { "name": "int-vals-0-1-is-toggle", "node": { "address": "/mute", "type": "i", "range": [{ "VALS": [0, 1] }] }, "expected": { "ok": true, "kinds": ["toggle", "select", "number", "button"], "widget": { "kind": "toggle", "type": "i", "label": "mute", "address": "/mute", "resend": true } } },
    { "name": "int-min-0-max-1-is-toggle", "node": { "address": "/mute", "type": "i", "range": [{ "MIN": 0, "MAX": 1 }] }, "expected": { "ok": true, "kinds": ["toggle", "slider", "number", "button"], "widget": { "kind": "toggle", "type": "i", "label": "mute", "address": "/mute", "resend": true } } },
    { "name": "int-vals-is-select", "node": { "address": "/mode", "type": "i", "range": [{ "VALS": [0, 1, 2, 2] }] }, "expected": { "ok": true, "kinds": ["toggle", "select", "number", "button"], "widget": { "kind": "select", "type": "i", "options": [{ "value": 0 }, { "value": 1 }, { "value": 2 }], "label": "mode", "address": "/mode", "resend": true } } },
    { "name": "string-vals-is-select", "node": { "address": "/scene", "type": "s", "range": [{ "VALS": ["a", "b", 3] }] }, "expected": { "ok": true, "kinds": ["select", "text", "button"], "widget": { "kind": "select", "type": "s", "options": [{ "value": "a" }, { "value": "b" }], "label": "scene", "address": "/scene", "resend": true } } },
    { "name": "float-range-is-slider", "node": { "address": "/volume", "type": "f", "range": [{ "MIN": 0, "MAX": 1 }] }, "expected": { "ok": true, "kinds": ["slider", "number", "button"], "widget": { "kind": "slider", "type": "f", "min": 0, "max": 1, "label": "volume", "address": "/volume", "resend": true } } },
    { "name": "range-object-is-accepted", "note": "RANGE を配列でなく 1 つのオブジェクトで書く実装もある", "node": { "address": "/volume", "type": "f", "range": { "MIN": -1, "MAX": 1 } }, "expected": { "ok": true, "kinds": ["slider", "number", "button"], "widget": { "kind": "slider", "type": "f", "min": -1, "max": 1, "label": "volume", "address": "/volume", "resend": true } } },
    { "name": "int-range-rounds-inward", "node": { "address": "/level", "type": "i", "range": [{ "MIN": 0.5, "MAX": 10.5 }] }, "expected": { "ok": true, "kinds": ["toggle", "slider", "number", "button"], "widget": { "kind": "slider", "type": "i", "min": 1, "max": 10, "label": "level", "address": "/level", "resend": true } } },
    { "name": "float-without-range-is-number", "node": { "address": "/speed", "type": "f" }, "expected": { "ok": true, "kinds": ["number", "button"], "widget": { "kind": "number", "type": "f", "label": "speed", "address": "/speed", "resend": true } } },
    { "name": "one-sided-range-is-number", "node": { "address": "/count", "type": "i", "range": [{ "MIN": 0 }] }, "expected": { "ok": true, "kinds": ["toggle", "number", "button"], "widget": { "kind": "number", "type": "i", "min": 0, "label": "count", "address": "/count", "resend": true } } },
    { "name": "string-is-text", "node": { "address": "/title", "type": "s", "description": "タイトル" }, "expected": { "ok": true, "kinds": ["text", "button"], "widget": { "kind": "text", "type": "s", "label": "タイトル", "address": "/title", "resend": true } } },
    { "name": "rgba-is-color", "node": { "address": "/tint", "type": "r" }, "expected": { "ok": true, "kinds": ["color"], "widget": { "kind": "color", "type": "r", "label": "tint", "address": "/tint", "resend": true } } },
    { "name": "ffff-color-is-color", "node": { "address": "/tint", "type": "ffff", "extendedType": ["color.r", "color.g", "color.b", "color.a"], "range": [{ "MIN": 0, "MAX": 1 }, { "MIN": 0, "MAX": 1 }, { "MIN": 0, "MAX": 1 }, { "MIN": 0, "MAX": 1 }] }, "expected": { "ok": true, "kinds": ["color", "composite", "button"], "widget": { "kind": "color", "type": "ffff", "label": "tint", "address": "/tint", "resend": true } } },
    { "name": "ffff-without-color-is-composite", "node": { "address": "/quat", "type": "ffff" }, "expected": { "ok": true, "kinds": ["color", "composite", "button"], "widget": { "kind": "composite", "label": "quat", "address": "/quat", "fields": [
      { "id": "a1", "label": "1", "kind": "number", "type": "f" }, { "id": "a2", "label": "2", "kind": "number", "type": "f" }, { "id": "a3", "label": "3", "kind": "number", "type": "f" }, { "id": "a4", "label": "4", "kind": "number", "type": "f" }
    ], "resend": true } } },
    { "name": "mixed-is-composite", "node": { "address": "/member/set", "type": "sTf", "range": [null, null, { "MIN": 0, "MAX": 2 }] }, "expected": { "ok": true, "kinds": ["composite", "button"], "widget": { "kind": "composite", "label": "set", "address": "/member/set", "fields": [
      { "id": "a1", "label": "1", "kind": "text", "type": "s" }, { "id": "a2", "label": "2", "kind": "toggle", "type": "T" }, { "id": "a3", "label": "3", "kind": "slider", "type": "f", "min": 0, "max": 2 }
    ], "resend": true } } },
    { "name": "write-only-does-not-resend", "node": { "address": "/light", "type": "T", "access": 2 }, "expected": { "ok": true, "kinds": ["toggle", "button"], "widget": { "kind": "toggle", "type": "T", "label": "light", "address": "/light", "resend": false } } },
    { "name": "read-only-is-display", "node": { "address": "/stats/fps", "type": "f", "access": 1 }, "expected": { "ok": true, "kinds": ["number"], "widget": { "kind": "number", "type": "f", "label": "fps", "address": "/stats/fps", "resend": false, "readOnly": true } } },
    { "name": "override-kind", "node": { "address": "/volume", "type": "f", "range": [{ "MIN": 0, "MAX": 1 }] }, "overrides": { "kind": "number", "resend": false }, "expected": { "ok": true, "kinds": ["slider", "number", "button"], "widget": { "kind": "number", "type": "f", "min": 0, "max": 1, "label": "volume", "address": "/volume", "resend": false } } },
    { "name": "override-to-button", "node": { "address": "/scene", "type": "si" }, "overrides": { "kind": "button" }, "expected": { "ok": true, "kinds": ["composite", "button"], "widget": { "kind": "button", "label": "scene", "address": "/scene", "args": [{ "type": "s", "value": "" }, { "type": "i", "value": 0 }] } } },
    { "name": "reject-override-not-allowed", "node": { "address": "/title", "type": "s" }, "overrides": { "kind": "slider" }, "expected": { "ok": false, "reason": "kind-not-allowed" } },
    { "name": "reject-int64", "node": { "address": "/big", "type": "h" }, "expected": { "ok": false, "reason": "unsupported-type" } },
    { "name": "reject-double", "node": { "address": "/d", "type": "d" }, "expected": { "ok": false, "reason": "unsupported-type" } },
    { "name": "reject-timetag", "node": { "address": "/t", "type": "t" }, "expected": { "ok": false, "reason": "unsupported-type" } },
    { "name": "reject-blob", "node": { "address": "/b", "type": "b" }, "expected": { "ok": false, "reason": "unsupported-type" } },
    { "name": "reject-array", "node": { "address": "/a", "type": "[ff]" }, "expected": { "ok": false, "reason": "unsupported-type" } },
    { "name": "reject-mixed-with-int64", "node": { "address": "/m", "type": "ih" }, "expected": { "ok": false, "reason": "unsupported-type" } },
    { "name": "reject-reserved-address", "node": { "address": "/sys/ping" }, "expected": { "ok": false, "reason": "invalid-address" } },
    { "name": "reject-space-in-address", "node": { "address": "/my param", "type": "f" }, "expected": { "ok": false, "reason": "invalid-address" } },
    { "name": "reject-read-only-without-value", "node": { "address": "/info", "access": 1 }, "expected": { "ok": false, "reason": "read-only-without-value" } }
  ]
}
