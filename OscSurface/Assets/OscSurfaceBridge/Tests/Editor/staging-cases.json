      "expected": { "echoes": [ { "address": "/x/value", "value": { "kind": "float", "i": 0, "f": 1.5, "s": "" } }, { "address": "/x/apply", "value": { "kind": "int", "i": 1, "f": 0.0, "s": "" } } ], "apply": { "fired": true, "trigger": "/x/apply", "values": [ { "address": "/x/value", "value": { "kind": "float", "i": 0, "f": 1.5, "s": "" } } ] }, "currentValues": [ { "address": "/x/value", "value": { "kind": "float", "i": 0, "f": 1.5, "s": "" } } ], "defaults": [ { "address": "/x/value", "literal": "1.5" } ], "errors": [] }
