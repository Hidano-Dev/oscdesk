      "description": "一括操作の展開書き込みと展開先個別エコー",
      "entries": [ { "address": "/group/all", "type": "int", "staged": false, "default": 0 }, { "address": "/group/01/value", "type": "int", "staged": true, "default": 0 }, { "address": "/group/02/value", "type": "int", "staged": true, "default": 0 } ],
