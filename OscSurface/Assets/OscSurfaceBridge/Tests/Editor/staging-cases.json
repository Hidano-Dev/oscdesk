  "cases": [
    {
      "id": "01-hold-echo-no-apply",
      "description": "ステージング対象の受信は保持と同一アドレスへのエコーだけを行う",
      "entries": [
        { "address": "/stage/value", "type": "int", "staged": true, "default": 0 }
      ],
      "triggers": [],
      "expansions": [],
      "receives": [
        { "address": "/stage/value", "value": { "kind": "int", "i": 7, "f": 0.0, "s": "" } }
      ],
      "expected": {
        "echoes": [
          { "address": "/stage/value", "value": { "kind": "int", "i": 7, "f": 0.0, "s": "" } }
        ],
        "apply": { "fired": false, "trigger": "", "values": [] },
        "currentValues": [
          { "address": "/stage/value", "value": { "kind": "int", "i": 7, "f": 0.0, "s": "" } }
        ],
        "defaults": [ { "address": "/stage/value", "literal": "7" } ],
        "errors": []
      }
    },
    {
      "id": "02-no-declaration-legacy",
      "description": "宣言が無い場合は従来挙動としてエコーのみ行う",
      "entries": [
        { "address": "/legacy/value", "type": "int", "staged": false, "default": 0 }
      ],
      "triggers": [],
      "expansions": [],
      "receives": [
        { "address": "/legacy/value", "value": { "kind": "int", "i": 3, "f": 0.0, "s": "" } }
      ],
      "expected": {
        "echoes": [
          { "address": "/legacy/value", "value": { "kind": "int", "i": 3, "f": 0.0, "s": "" } }
