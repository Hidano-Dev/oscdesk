        "currentValues": [ { "address": "/legacy/value", "value": { "kind": "int", "i": 3, "f": 0.0, "s": "" } } ],
        "defaults": [ { "address": "/legacy/value", "literal": "3" } ],
        "errors": []
      }
    },
    {
      "id": "03-trigger-nonzero-and-zero",
      "description": "トリガは非ゼロ値で発火し、値 0 ではエコーだけを行う",
      "entries": [
        { "address": "/slot/name", "type": "string", "staged": true, "default": "" },
        { "address": "/slot/update", "type": "button", "staged": false, "default": 0 }
      ],
      "triggers": [ { "address": "/slot/update", "applyPatterns": [ "/slot/*" ] } ],
      "expansions": [],
      "receives": [
        { "address": "/slot/name", "value": { "kind": "string", "i": 0, "f": 0.0, "s": "A" } },
        { "address": "/slot/update", "value": { "kind": "int", "i": 1, "f": 0.0, "s": "" } },
        { "address": "/slot/update", "value": { "kind": "int", "i": 0, "f": 0.0, "s": "" } }
      ],
      "expected": {
        "echoes": [
          { "address": "/slot/name", "value": { "kind": "string", "i": 0, "f": 0.0, "s": "A" } },
          { "address": "/slot/update", "value": { "kind": "int", "i": 1, "f": 0.0, "s": "" } },
          { "address": "/slot/update", "value": { "kind": "int", "i": 0, "f": 0.0, "s": "" } }
        ],
        "apply": { "fired": true, "trigger": "/slot/update", "values": [ { "address": "/slot/name", "value": { "kind": "string", "i": 0, "f": 0.0, "s": "A" } } ] },
        "currentValues": [ { "address": "/slot/name", "value": { "kind": "string", "i": 0, "f": 0.0, "s": "A" } } ],
        "defaults": [ { "address": "/slot/name", "literal": "\"A\"" } ],
        "errors": []
      }
    },
    {
      "id": "04-apply-retains-values",
      "description": "適用後も現在値を破棄せず保持する",
      "entries": [ { "address": "/x/value", "type": "float", "staged": true, "default": 0.0 } ],
      "triggers": [ { "address": "/x/apply", "applyPatterns": [ "/x/*" ] } ],
      "expansions": [],
      "receives": [
        { "address": "/x/value", "value": { "kind": "float", "i": 0, "f": 1.5, "s": "" } },
        { "address": "/x/apply", "value": { "kind": "int", "i": 1, "f": 0.0, "s": "" } }
