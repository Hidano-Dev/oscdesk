{
  "format": "oscdesk-surface",
  "version": 2,
  "name": "MinimalReceiver",
  "parameters": [
    {
      "id": "value",
      "label": "Value",
      "type": "f",
      "kind": "state",
      "range": [0, 1],
      "step": 0.01,
      "default": 0.5
    },
    {
      "id": "hello",
      "label": "Hello",
      "type": "i",
      "kind": "trigger",
      "value": 1
    }
  ],
  "screens": [
    {
      "id": "main",
      "label": "Main",
      "children": [
        { "kind": "control", "param": "value", "widget": "slider" },
        { "kind": "control", "param": "hello", "widget": "button" }
      ]
    }
  ],
  "bindings": {
    "osc": {
      "parameters": [
        { "id": "value", "address": "/sample/value" },
        { "id": "hello", "address": "/sample/hello" }
      ]
    }
  }
}
