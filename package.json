{
  "name": "oscdesk",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present run build",
    "typecheck": "corepack pnpm -r run typecheck",
    "test": "node scripts/run-tests.mjs all",
    "test:fast": "node scripts/run-tests.mjs fast",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:py": "node scripts/run-tests.mjs py",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "test:guards": "node scripts/run-tests.mjs guards",
    "test:changed": "node scripts/run-tests.mjs changed"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "osc": "^2.4.5",
    "playwright": "^1.62.1",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0",
    "ws": "^8.18.0"
  }
}
